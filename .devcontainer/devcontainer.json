{
  "name": "Microsoft Fabric Hands-on Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22.22.0",
      "nodeGypDependencies": true,
      "npmVersion": "10.9.4",
      "pnpmVersion": "none",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {
      "version": "2.89.1",
      "installBicep": false
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/scripts/setup.sh && bash .devcontainer/scripts/verify.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Fabric App preview",
      "onAutoForward": "notify"
    }
  }
}
